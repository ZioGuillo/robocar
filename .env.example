# Server
PORT=8000

# Camera stream URL — mjpg-streamer stream endpoint (not the HTML page)
# Example: http://192.168.1.93:9000/?action=stream
CAMERA_STREAM_URL=

# Motor default speed (0.0 to 1.0)
MOTOR_SPEED_DEFAULT=0.75

# Servo GPIO pins (BCM numbering — avoid 17/27, used by RRB3)
PAN_SERVO_PIN=12
TILT_SERVO_PIN=13

# Buzzer GPIO pin (for future audio alerts)
BUZZER_PIN=18

# Obstacle avoidance: stop and turn when sonar reads below this distance (cm)
OBSTACLE_THRESHOLD_CM=20

# Session secret key — signs the login cookie; must be 32+ random characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Public base URL — set this when behind a reverse proxy or Cloudflare tunnel
# so GitHub OAuth redirect_uri matches your registered callback URL.
# Example: https://rover.funpython.org
BASE_URL=

# Rate limiting — max motor commands per second per client IP (0 to disable)
MOTOR_RATE_LIMIT=20
