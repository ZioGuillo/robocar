[Unit]
Description=RoboControl Robot Car Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
EnvironmentFile=/home/pi/robocar/.env
ExecStart=/home/pi/robocar-venv/bin/robocar
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robocar

[Install]
WantedBy=multi-user.target
