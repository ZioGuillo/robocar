[Unit]
Description=RoboControl Robot Car Server
After=network-online.target cloudflared.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/robocontrol
EnvironmentFile=/home/pi/robocontrol/.env
ExecStart=/home/pi/robocontrol/venv/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robocontrol

[Install]
WantedBy=multi-user.target
